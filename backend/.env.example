# Python FastAPI Backend — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here

# ── Minute-bucket aggregator (Step 5) ─────────────────────────────────────────
# `zone_minute_stats` has NO INSERT policy — measured data is deliberately
# read-only to every browser client, so the only credential that can write
# buckets is the one that bypasses RLS.
#
# Without this key the aggregator still runs and still produces correct buckets
# locally in SQLite; they simply are not pushed to Postgres.
#
# Supabase dashboard -> Settings -> API -> service_role (secret).
# NEVER expose this to the browser. Backend only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Privacy blur default (Identity tracking, Step 1) ──────────────────────────
# Whether a new analysis session starts with head-region blur ON.
#
# Default is FALSE. Blur destroys the face signal, and the identity pipeline
# needs that signal — a door camera cannot recognise a face it never sees.
# Leave it unset (or false) for development and for any deployment doing
# per-employee identification.
#
# Set to `true` for a privacy-by-default deployment: every session then starts
# blurred and a viewer must deliberately turn it off.
#
# Accepted truthy values: 1, true, yes, on (case-insensitive). Anything else
# is treated as false.
#
# Per-session override: append `?blur=true` / `?blur=false` to the processing
# WebSocket URL. This is how one camera runs unblurred while the rest of the
# deployment keeps the default.
PRIVACY_BLUR_DEFAULT=false

# ── Identity tracking (Phase B, Steps 5-6) ────────────────────────────────────
# Appearance signatures (OSNet re-ID) and fragment stitching. On by default.
#
# Set to false to run the pipeline exactly as it behaved after Step 4: identity
# rows are still written, still UNKNOWN, but OSNet is never loaded. Reach for
# this on a machine with no GPU headroom, or for a deployment that does not want
# per-person tracking at all.
#
# Cost measured on an RTX 4060 with 3 people per frame: ~7 ms/frame
# (~2.4 ms/person), 55 -> 39 FPS.
IDENTITY_TRACKING=true

# ── Employee day stats (Phase B, Steps 7-8) ───────────────────────────────────
# Chair exits, breaks and focus blocks are rolled up per employee per day and
# synced to Postgres `employee_day_stats`, alongside the anonymous
# `zone_minute_stats` and never instead of it.
#
# This needs SUPABASE_SERVICE_ROLE_KEY above: the seat map (who sits at which
# desk) is read from Postgres, and the day stats are written back through it.
# Without the key the pipeline still runs — identities are tracked and stitched,
# they are simply never named, and every row stays UNKNOWN.
#
# The thresholds live in backend/app/db/employee_aggregator.py and are worth
# tuning on your own footage:
#   CHAIR_EXIT_MIN_SECONDS   90    a shorter absence is bending down, not leaving
#   BREAK_MIN_SECONDS       300    5 minutes
#   FOCUS_BLOCK_MIN_SECONDS 1200   20 minutes of unbroken seated work

# ── Face enrolment (Phase C, Step 9) ──────────────────────────────────────────
# Enrolment reads and writes Postgres directly, so it needs
# SUPABASE_SERVICE_ROLE_KEY above. Without it /api/v1/employees/{id}/templates
# returns 503 with a message saying so, rather than failing obscurely.
#
# NO PHOTOGRAPH IS EVER STORED. Each image is graded, converted to a 512-d
# ArcFace vector, and discarded — never written to disk, never logged, never
# returned by the API. Migration 020 revokes read access to face_templates.
# embedding from every browser session, so not even an admin can read one back.
#
# The quality gate lives in backend/app/cv/face_enroller.py:
#   MIN_DET_SCORE          0.65   detector confidence
#   MIN_EYE_DISTANCE_PX    40     below this, matching degrades sharply
#   MIN_SHARPNESS          45     a blurry enrolment poisons every later match
#   MIN/MAX_TEMPLATES      3/5    photos per person
