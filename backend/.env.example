# Python FastAPI Backend — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here

# ── Minute-bucket aggregator (Step 5) ─────────────────────────────────────────
# `zone_minute_stats` has NO INSERT policy — measured data is deliberately
# read-only to every browser client, so the only credential that can write
# buckets is the one that bypasses RLS.
#
# Without this key the aggregator still runs and still produces correct buckets
# locally in SQLite; they simply are not pushed to Postgres.
#
# Supabase dashboard -> Settings -> API -> service_role (secret).
# NEVER expose this to the browser. Backend only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Privacy blur default ──────────────────────────────────────────────────────
# Whether a new analysis session starts with head-region blur ON.
#
# Default is FALSE for development, where the raw picture is what you are
# debugging. Set to `true` for a privacy-by-default deployment: every session
# then starts blurred and a viewer must deliberately turn it off. (Safety
# evidence snapshots are always blurred, whatever this says.)
#
# Accepted truthy values: 1, true, yes, on (case-insensitive). Anything else
# is treated as false.
#
# Per-session override: append `?blur=true` / `?blur=false` to the processing
# WebSocket URL.
PRIVACY_BLUR_DEFAULT=false

# ── Safety compliance layer (docs/safety-pivot/PROJECT_SCOPE_AND_DESIGN.md) ───
# Master switch. OFF by default: with it off the pipeline behaves exactly as it
# did before the safety work, so nothing below has any effect.
# Only 1 / true / yes / on turn it on; anything else leaves it off.
SAFETY_ENABLED=false
#
# Every threshold below is optional. Leave a line commented to keep the default
# (shown). A value that cannot be parsed or is out of range is ignored with a
# warning in the log. Defaults live in backend/app/safety/config.py; the PPE
# evidence ones come from backend/app/cv/ppe_evidence.py.
#
# PPE detection and evidence
# PPE_MODEL_PATH=ppe_training/runs/ppe_yolov8m_v1/weights/best.pt
# SAFETY_PPE_CONF_FLOOR=0.20            detector boxes kept at/above this
# SAFETY_PPE_PRESENT_CONF=0.45          a detection at/above this counts as "seen"
# SAFETY_PPE_WEAK_CONF=0.20             below this counts as "nothing there" (must be < PRESENT)
# SAFETY_PPE_WINDOW_FRAMES=30           rolling evidence window per worker
# SAFETY_PPE_MIN_CLEAR_FRAMES=8         fewer clear frames -> UNVERIFIABLE
# SAFETY_PPE_PRESENCE_FRACTION=0.60     item PRESENT if seen in this share of clear frames
# SAFETY_PPE_ABSENCE_FRACTION=0.90      item ABSENT only if missing in this share
# SAFETY_PPE_STALE_S=10                 evidence older than this is ignored
# SAFETY_PPE_MIN_PERSON_HEIGHT_PX=90    smaller people give no evidence either way
# SAFETY_PPE_MIN_PERSON_WIDTH_PX=28
# SAFETY_PPE_CROWD_IOU=0.30             overlap with another person -> frame not clear
# SAFETY_PPE_EVERY_N_FRAMES=2           run the PPE model on every Nth frame
#
# Zone events
# SAFETY_ENTER_CONFIRM_S=0.7            inside this long before "entered" is recorded
# SAFETY_EXIT_CONFIRM_S=1.0             outside this long before "exited" is recorded
# SAFETY_LOST_GRACE_S=5                 unseen this long inside a zone -> LOST_IN_ZONE
# SAFETY_LOST_TTL_S=8                   unseen this long -> visit closed (must be >= LOST_GRACE)
#
# Decisions
# SAFETY_ENTRY_EVIDENCE_WAIT_S=4        wait this long for PPE evidence after entering
# SAFETY_CONTINUOUS_PPE_GRACE_S=3       R2: missing PPE this long inside -> flag
# SAFETY_DWELL_WARN_FRACTION=0.8        R3: warning at this share of the time limit
# SAFETY_REALERT_AFTER_S=60             gap before a new alert for the same rule/zone/worker
#
# Man-down
# SAFETY_MAN_DOWN_ANGLE_DEG=60          torso this far from vertical counts as "down"
# SAFETY_MAN_DOWN_MIN_S=5               down and still this long -> alert
# SAFETY_MAN_DOWN_UPRIGHT_DEG=45        SITTING ignored only below this angle (must be < ANGLE)
# SAFETY_MAN_DOWN_STILL_SPEED=0.15      person-heights per second counted as "still"
#
# Lone worker / occupancy
# SAFETY_OCCUPANCY_GRACE_S=10
# SAFETY_OCCUPANCY_WINDOW_S=2           median count over this window
# SAFETY_OCCUPANCY_MIN_CLEAR_FRACTION=0.6
#
# Evidence snapshots (written to backend/evidence/, which is git-ignored)
# SAFETY_EVIDENCE_RETENTION_DAYS=7
# SAFETY_SNAPSHOT_UNVERIFIABLE=false    also save snapshots for UNVERIFIABLE decisions
