# ─── Python ──────────────────────────────────────────────────────────────────
venv/
.venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# ─── Environment / Secrets ───────────────────────────────────────────────────
# NEVER commit real .env files
backend/.env
frontend/.env.local
.env
.env.local
.env.*.local

# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite databases are generated at runtime — do not commit
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ─── YOLOv8 / AI Model Weights ───────────────────────────────────────────────
# Large binary files — download separately with setup script
*.pt
*.onnx
*.engine
*.weights

# ─── Sample / Test Videos ────────────────────────────────────────────────────
sample_videos/*.mp4
sample_videos/*.avi
sample_videos/*.mkv
sample_videos/*.mov

# ─── Frontend (Next.js / Node) ───────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/.next-prod/

# ─── Prisma ──────────────────────────────────────────────────────────────────
# The client is generated from schema.prisma by `prisma generate`, which runs
# on install. Committing it would mean a stale client outliving a schema change.
frontend/app/generated/
frontend/dist/
frontend/build/
frontend/out/
.npm/

# ─── IDE & OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ────────────────────────────────────────────────────────────────────
*.bak
*.swp
*.tmp

# Re-ID model weights. Fetched by backend/models/download_models.py rather than
# committed — a binary in git history is dead weight for every future clone.
backend/models/*.pth
backend/models/*.onnx

# Test face images, fetched on demand by backend/tests/test_face_enrolment.py.
# Photographs of people do not belong in git, even public ones.
backend/tests/_faces/

# Evaluation artefacts. The code and the committed report are tracked; the
# intermediate signature caches and per-run truth files are not — they are
# large, regenerable, and change on every run.
backend/eval/results/frames_*.pkl
backend/eval/results/thumbnails/
backend/eval/results/truth_*.json
backend/eval/results/tracks_*.json

# Local HTTPS development certificate. Machine-specific and regenerable
# (scripts/make_dev_cert.py); the private key must never be committed.
certs/

# PPE detector training assets (large, regenerable; weights are already ignored via *.pt)
ppe_training/datasets/
ppe_training/runs/

# Safety evidence snapshots: blurred images of flagged events. Personal data
# with a retention limit — never committed.
backend/evidence/

# Ultralytics Construction-PPE export (signed, expiring image links); the images live in ppe_training/datasets/ (ignored)
construction-ppe.ndjson
