# ─── Python ──────────────────────────────────────────────────────────────────
venv/
.venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# ─── Environment / Secrets ───────────────────────────────────────────────────
# NEVER commit real .env files
backend/.env
frontend/.env.local
.env
.env.local
.env.*.local

# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite databases are generated at runtime — do not commit
*.db
*.sqlite
*.sqlite3

# ─── YOLOv8 / AI Model Weights ───────────────────────────────────────────────
# Large binary files — download separately with setup script
*.pt
*.onnx
*.engine
*.weights

# ─── Sample / Test Videos ────────────────────────────────────────────────────
sample_videos/*.mp4
sample_videos/*.avi
sample_videos/*.mkv
sample_videos/*.mov

# ─── Frontend (Next.js / Node) ───────────────────────────────────────────────
frontend/node_modules/
frontend/.next/

# ─── Prisma ──────────────────────────────────────────────────────────────────
# The client is generated from schema.prisma by `prisma generate`, which runs
# on install. Committing it would mean a stale client outliving a schema change.
frontend/app/generated/
frontend/dist/
frontend/build/
frontend/out/
.npm/

# ─── IDE & OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ────────────────────────────────────────────────────────────────────
*.bak
*.swp
*.tmp
